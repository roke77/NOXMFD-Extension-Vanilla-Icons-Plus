<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Vanilla Icons PLUS bridge: a standalone NOXMFD extension (see NOXMFD's EXTENSIONS.md and
    docs/vanilla-icons-plus-extension.md). Lives in its own repo, separate from NOXMFD's own
    source — it never edits NOXMFD's plugin/web code, only consumes the public NOXMFD.Api icon-
    color-override surface via the prebuilt lib\NOXMFD.dll committed alongside this project.

    >>> SET YOUR GAME PATH <<<
    GameDir must point at your Nuclear Option install on the machine that BUILDS this. Don't edit
    the default below — create a local, gitignored GameDir.props next to this file instead:

      <Project><PropertyGroup>
        <GameDir>D:\SteamLibrary\steamapps\common\Nuclear Option</GameDir>
      </PropertyGroup></Project>
  -->
  <Import Project="GameDir.props" Condition="Exists('GameDir.props')" />

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>NOXMFD.VanillaIconsPlusBridge</AssemblyName>
    <Product>NOXMFD: Vanilla Icons Plus Bridge</Product>
    <Description>Mirrors NO-VanillaIconsPLUS's unit colors onto NOXMFD's MAP page</Description>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>VanillaIconsPlusBridge</RootNamespace>
    <DebugType>portable</DebugType>
    <NoWarn>BepInEx002</NoWarn>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.6" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <!-- GameAssets.i.HUDFriendly/HUDHostile/HUDNeutral — the same fields VanillaIconsPLUS itself
         writes and NOXMFD's own TelemetryReader reads. Referencing the game directly (like NOXMFD
         does) rather than going through VanillaIconsPLUS for these three, since they sit on
         private ConfigEntry<Color> fields there with no externally-subscribable change event. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\NuclearOption_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The only NOXMFD dependency this project has: its public Api surface. Referenced as a
         prebuilt DLL (not source) since this repo is standalone from NOXMFD's own — Private=false
         because BepInEx already loads NOXMFD.dll itself; copying a second copy alongside this
         plugin would double-load the assembly. -->
    <Reference Include="NOXMFD">
      <HintPath>lib\NOXMFD.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- VanillaIconsPLUS's own AAUnitsHUD/SpecialAAUnitsHUD ConfigEntry<Color> fields and its
         AAUnitHelper unit-type whitelists — both public. Same Private=false reasoning as NOXMFD
         above; VanillaIconsPLUS is a hard BepInDependency (see Plugin.cs), so BepInEx guarantees
         it's already loaded. Gitignored, unlike lib\NOXMFD.dll above — it's a third-party mod's
         binary, not this repo's to redistribute; see README.md's Building section. -->
    <Reference Include="VanillaIconsPLUS">
      <HintPath>lib\VanillaIconsPLUS.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build">
    <Copy
      SourceFiles="$(OutputPath)$(AssemblyName).dll"
      DestinationFolder="$(GameDir)\BepInEx\plugins"
      OverwriteReadOnlyFiles="true" />
    <Message Text="Deployed $(AssemblyName).dll to $(GameDir)\BepInEx\plugins" Importance="high" />
  </Target>

</Project>
